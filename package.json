{
  "name": "zentro-browser",
  "productName": "Zentro Browser",
  "version": "1.3.3",
  "description": "Zentro Browser - a privacy-minded Chromium-based browser for Windows.",
  "main": "main.js",
  "author": "Zentro dev team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/core.test.js test/profile.test.js test/pages.test.js test/features.test.js test/accounts.test.js test/ai.test.js test/school.test.js",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zentro.browser",
    "productName": "Zentro Browser",
    "copyright": "Copyright (c) 2026 Zentro",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "pages/**/*", "data/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Zentro-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zentro Browser",
      "uninstallDisplayName": "Zentro Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
